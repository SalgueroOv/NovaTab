{
  "manifest_version": 3,
  "name": "NovaTab",
  "description": "Página de nueva pestaña para tus servicios de casa o del trabajo, con buscador y widgets.",
  "version": "4.0.0",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["storage", "favicon", "geolocation", "topSites"],
  "action": { "default_title": "NovaTab" },
  "background": { "service_worker": "background.js" }
}
